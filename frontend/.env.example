# Copy to .env.local and configure a provider.
# For production, prefer the n8n webhook so API keys stay server-side.

# Direct Gemini mode; VITE_ variables are visible in browser bundles.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# n8n mode (recommended for deployed use).
VITE_N8N_WEBHOOK_URL=https://your-n8n-host/webhook/your-workflow-id
